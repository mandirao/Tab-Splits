# Supabase Postgres connection string (Dashboard → Connect → Transaction pooler URI).
# URL-encode any special characters in the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<region>.pooler.supabase.com:6543/postgres

# Supabase project URL + service-role key (Dashboard → Settings → API).
# Used server-side only, for Supabase Storage (receipt images).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# OpenAI API key — receipt scanning (gpt-4o vision) and item categorization
OPENAI_API_KEY=sk-...

# Resend — password reset emails (key starts with re_)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@example.com

# Random string used to sign session cookies (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Comma-separated list of account emails allowed to view /admin (case-insensitive)
ADMIN_EMAILS=you@example.com

# Optional: PostHog analytics key (client-side, publishable)
VITE_POSTHOG_KEY=
